@model Domain.DTOs.OrderItems.GetOrderItemDto

@{
    ViewData["Title"] = "Delete ordeitem";
}

<h2>Are you sure you want to delete this?</h2>

<div>
    <h4></h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">OrderId</dt>
        <dd class="col-sm-10">@Model.OrderId</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">ProductId</dt>
        <dd class="col-sm-10">@Model.ProductId</dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">Quantity</dt>
        <dd class="col-sm-10">@Model.Quantity</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
